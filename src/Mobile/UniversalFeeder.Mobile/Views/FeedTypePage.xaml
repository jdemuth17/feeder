<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:UniversalFeeder.Mobile.Models"
             x:Class="UniversalFeeder.Mobile.Views.FeedTypePage"
             Title="Feed Types">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- ── Saved feed types ──────────────────────────────────────── -->
            <Label Text="Saved Feed Types" FontSize="18" FontAttributes="Bold" />

            <CollectionView ItemsSource="{Binding FeedTypes}" HeightRequest="220"
                            EmptyView="No feed types yet. Add one below.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FeedType">
                        <Frame Padding="12" Margin="0,4" CornerRadius="8" HasShadow="True">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" />
                                    <Label Text="{Binding SecondsPerCup, StringFormat='{0:F2}s per cup'}"
                                           FontSize="12" TextColor="Gray" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="Delete"
                                        TextColor="Red" BackgroundColor="Transparent"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="1" Color="LightGray" />

            <!-- ── Quick add (manual rate entry) ────────────────────────── -->
            <Label Text="Quick Add" FontSize="16" FontAttributes="Bold" />
            <Label Text="Name" FontSize="13" TextColor="Gray" />
            <Entry Text="{Binding NewName}" Placeholder="e.g. Kibble Dog Food" />
            <Label Text="Seconds per cup" FontSize="13" TextColor="Gray" />
            <Entry x:Name="manualSecondsEntry" Keyboard="Numeric"
                   Text="{Binding NewSecondsPerCup, StringFormat='{0:F2}'}"
                   Placeholder="5.00" />
            <Button Text="Add Feed Type" Command="{Binding AddManualCommand}"
                    BackgroundColor="#2196F3" TextColor="White" CornerRadius="8" HeightRequest="44" />

            <BoxView HeightRequest="1" Color="LightGray" />

            <!-- ── Calibrate with feeder ─────────────────────────────────── -->
            <Label Text="Calibrate with Feeder" FontSize="16" FontAttributes="Bold" />
            <Label FontSize="12" TextColor="Gray">
                <Label.Text>Run the motor, measure how much food came out, and let the app calculate the rate. Select a feeder on the dashboard first.</Label.Text>
            </Label>

            <Label Text="Feed Type Name" FontSize="13" TextColor="Gray" />
            <Entry Text="{Binding NewName}" Placeholder="e.g. Pellet Feed" />

            <Label Text="{Binding CalibrationSeconds, StringFormat='Run motor for: {0:F0} seconds'}" />
            <Slider Minimum="1" Maximum="300" Value="{Binding CalibrationSeconds}" />

            <Button Text="▶ Run Motor Now" Command="{Binding RunCalibrationCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                    BackgroundColor="#FF9800" TextColor="White" CornerRadius="8" HeightRequest="44" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

            <Label Text="{Binding CalibrationStatus}" TextColor="Gray" FontSize="13"
                   HorizontalOptions="Center" />

            <Label Text="How many cups came out?" FontSize="13" TextColor="Gray" />
            <Label x:Name="measuredCupsLabel" FontSize="15" HorizontalOptions="Center" />
            <Picker x:Name="measuredCupsPicker" Title="Select measured cups"
                    SelectedIndexChanged="OnMeasuredCupsPickerChanged" />

            <Button Text="💾 Save Rate" Command="{Binding SaveCalibrationCommand}"
                    BackgroundColor="#4CAF50" TextColor="White" CornerRadius="8" HeightRequest="44" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:UniversalFeeder.Mobile.Models"
             x:Class="UniversalFeeder.Mobile.Views.SchedulePage"
             Title="Edit Schedule">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Schedule" FontAttributes="Bold" FontSize="20" />

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Center" />

            <CollectionView ItemsSource="{Binding Entries}" HeightRequest="240">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FeedingScheduleEntry">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Padding="6">
                            <TimePicker Grid.Column="0" Time="{Binding Time, Mode=TwoWay}" />
                            <Label Grid.Column="1" VerticalOptions="Center" FontSize="13">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding DurationSeconds, StringFormat='{0:F1}s motor'}" FontAttributes="Bold" />
                                        <Span Text=" · " />
                                        <Span Text="{Binding ChimeCount, StringFormat='{0}× chime'}" />
                                        <Span Text=" · " />
                                        <Span Text="{Binding ChimeDurationSeconds, StringFormat='{0:F1}s each'}" />
                                        <Span Text=" · lead " />
                                        <Span Text="{Binding ChimeLeadSeconds, StringFormat='{0}s'}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Switch Grid.Column="2" IsToggled="{Binding Enabled, Mode=TwoWay}" />
                            <Button Grid.Column="3" Text="✕"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                    CommandParameter="{Binding .}"
                                    TextColor="Red" BackgroundColor="Transparent" WidthRequest="40" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Add-entry form -->
            <Frame Padding="12" CornerRadius="8" BorderColor="LightGray">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Add Entry" FontAttributes="Bold" FontSize="15" />

                    <TimePicker x:Name="timePicker" />

                    <!-- Feed type picker -->
                    <Label Text="Feed Type" FontSize="13" TextColor="Gray" />
                    <Picker x:Name="feedTypePicker" Title="(None — enter seconds)"
                            SelectedIndexChanged="OnFeedTypePickerChanged" />

                    <!-- Cups (shown when a feed type is selected) -->
                    <VerticalStackLayout x:Name="cupsSection" IsVisible="False" Spacing="4">
                        <Label Text="Amount" FontSize="13" TextColor="Gray" />
                        <Picker x:Name="cupsPicker" Title="Select cups"
                                SelectedIndexChanged="OnCupsPickerChanged" />
                        <Label x:Name="computedDurationLabel" FontSize="12" TextColor="Gray" />
                    </VerticalStackLayout>

                    <!-- Raw seconds (shown when no feed type) -->
                    <VerticalStackLayout x:Name="rawSecondsSection" Spacing="4">
                        <Label Text="Duration (seconds)" FontSize="13" TextColor="Gray" />
                        <Entry x:Name="amountEntry" Placeholder="5" Keyboard="Numeric" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="LightGray" Margin="0,4" />
                    <Label Text="Chime" FontAttributes="Bold" FontSize="14" />

                    <!-- Chime count -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label x:Name="chimeCountLabel" Text="3 chimes" VerticalOptions="Center" FontSize="13" />
                        <Stepper x:Name="chimeCountStepper" Grid.Column="1"
                                 Minimum="0" Maximum="5" Increment="1" Value="3"
                                 ValueChanged="OnChimeCountStepperChanged" />
                    </Grid>

                    <!-- Chime duration (per beep) -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label x:Name="chimeDurationLabel" Text="3.0s per chime" VerticalOptions="Center" FontSize="13" />
                        <Stepper x:Name="chimeDurationStepper" Grid.Column="1"
                                 Minimum="0.2" Maximum="5.0" Increment="0.2" Value="3.0"
                                 ValueChanged="OnChimeDurationStepperChanged" />
                    </Grid>

                    <!-- Chime lead -->
                    <Label Text="Chime lead (seconds before motor)" FontSize="13" TextColor="Gray" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Stepper x:Name="chimeLeadStepper" Grid.Column="1"
                                 Minimum="0" Maximum="30" Increment="1" Value="0"
                                 ValueChanged="OnChimeLeadStepperChanged" />
                        <Label x:Name="chimeLeadLabel" Text="0s before motor" VerticalOptions="Center" FontSize="13" />
                    </Grid>

                    <Switch x:Name="enabledSwitch" IsToggled="True" />
                    <Button Text="Add" Clicked="OnAddClicked"
                            BackgroundColor="#4CAF50" TextColor="White" CornerRadius="8" HeightRequest="44" />
                </VerticalStackLayout>
            </Frame>

            <Button Text="Save &amp; Send" Command="{Binding SaveCommand}"
                    BackgroundColor="#2196F3" TextColor="White" CornerRadius="8" HeightRequest="44" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:UniversalFeeder.Mobile.Models"
             x:Class="UniversalFeeder.Mobile.Views.DashboardPage"
             Title="My Feeders">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Connection Status -->
            <Frame Padding="12" CornerRadius="8" BorderColor="{Binding ConnectionStatusColor}">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout>
                        <Label Text="{Binding ConnectionStatusText}" 
                               FontAttributes="Bold" FontSize="16"
                               TextColor="{Binding ConnectionStatusColor}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" 
                            Text="{Binding ConnectButtonText}"
                            Command="{Binding ConnectCommand}"
                            BackgroundColor="{Binding ConnectionStatusColor}"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="40" />
                </Grid>
            </Frame>

            <!-- Feeder List -->
            <Label Text="Feeders" FontSize="20" FontAttributes="Bold" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Feeders}" Spacing="0">
                <BindableLayout.EmptyView>
                    <Label Text="No feeders registered. Go to Setup tab to add one."
                           TextColor="Gray" Margin="0,8" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:FeederDevice">
                        <Frame Padding="12" Margin="0,4" CornerRadius="8" HasShadow="True"
                               BorderColor="#666" BackgroundColor="#2A2A2A">
                            <Frame.Triggers>
                                <DataTrigger TargetType="Frame" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BorderColor" Value="#2196F3" />
                                    <Setter Property="BackgroundColor" Value="#1565C0" />
                                </DataTrigger>
                            </Frame.Triggers>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectFeederCommand}"
                                    CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                                <Label Text="{Binding Nickname}" FontAttributes="Bold" FontSize="16"
                                       TextColor="White" />
                                <Label Grid.Row="1" Text="{Binding UniqueId, StringFormat='ID: {0}'}"
                                       FontSize="12" TextColor="#BBBBBB" />
                                <Button Grid.Column="1" Grid.RowSpan="2"
                                        Text="✏" TextColor="#64B5F6"
                                        BackgroundColor="Transparent"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RenameFeederCommand}"
                                        CommandParameter="{Binding .}"
                                        WidthRequest="40" HeightRequest="40" />
                                <Button Grid.Column="2" Grid.RowSpan="2"
                                        Text="✕" TextColor="#FF5252"
                                        BackgroundColor="Transparent"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveFeederCommand}"
                                        CommandParameter="{Binding .}"
                                        WidthRequest="40" HeightRequest="40" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Controls (only visible when a feeder is selected) -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding HasSelectedFeeder}">
                <BoxView HeightRequest="1" Color="LightGray" />
                
                <Label Text="{Binding SelectedFeeder.Nickname, StringFormat='Control: {0}'}" 
                       FontSize="18" FontAttributes="Bold" />

                <!-- Feed Type Picker -->
                <Picker x:Name="dashFeedTypePicker" Title="Feed type (optional)" SelectedIndexChanged="OnDashFeedTypePickerChanged" />

                <!-- Cups section (visible when feed type selected) -->
                <VerticalStackLayout x:Name="dashCupsSection" IsVisible="False" Spacing="4">
                    <Picker x:Name="dashCupsPicker" Title="Select amount" SelectedIndexChanged="OnDashCupsPickerChanged" />
                    <Label x:Name="dashComputedLabel" FontSize="12" TextColor="Gray" />
                </VerticalStackLayout>

                <!-- Raw seconds section (visible when no feed type) -->
                <VerticalStackLayout x:Name="dashRawSection">
                    <Label Text="{Binding FeedDurationSeconds, StringFormat='Feed Duration: {0} seconds'}" />
                    <Slider Minimum="1" Maximum="30" 
                            Value="{Binding FeedDurationSeconds}" />
                </VerticalStackLayout>

                <!-- Chime defaults (used by Chime button + Feed Now) -->
                <Frame Padding="10" CornerRadius="8" BorderColor="LightGray">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Chime settings" FontAttributes="Bold" FontSize="14" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding ChimeCount, StringFormat='Chimes: {0}'}" VerticalOptions="Center" FontSize="13" />
                            <Stepper Grid.Column="1" Minimum="0" Maximum="5" Increment="1" Value="{Binding ChimeCount, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding ChimeDurationSeconds, StringFormat='Each: {0:F1}s'}" VerticalOptions="Center" FontSize="13" />
                            <Stepper Grid.Column="1" Minimum="0.2" Maximum="5.0" Increment="0.2" Value="{Binding ChimeDurationSeconds, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding ChimeLeadSeconds, StringFormat='Lead before motor: {0}s'}" VerticalOptions="Center" FontSize="13" />
                            <Stepper Grid.Column="1" Minimum="0" Maximum="30" Increment="1" Value="{Binding ChimeLeadSeconds, Mode=TwoWay}" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Action Buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Text="🔔 Chime" 
                            Command="{Binding ChimeCommand}"
                            BackgroundColor="#FF9800"
                            TextColor="White"
                            FontSize="18"
                            CornerRadius="12"
                            HeightRequest="60" />
                    <Button Grid.Column="1" 
                            Text="🍽 Feed Now" 
                            Command="{Binding FeedCommand}"
                            BackgroundColor="#4CAF50"
                            TextColor="White"
                            FontSize="18"
                            CornerRadius="12"
                            HeightRequest="60" />
                </Grid>
                <Button Text="Edit Schedule" Command="{Binding EditScheduleCommand}" BackgroundColor="#2196F3" TextColor="White" CornerRadius="8" HeightRequest="44" />
            </VerticalStackLayout>

            <Button Text="Manage Feed Types" Command="{Binding EditFeedTypesCommand}" BackgroundColor="#9C27B0" TextColor="White" CornerRadius="8" HeightRequest="44" />
            <Button Text="Change Wi-Fi" Command="{Binding ReconfigureWifiCommand}" IsVisible="{Binding HasSelectedFeeder}" BackgroundColor="#FF9800" TextColor="White" CornerRadius="8" HeightRequest="44" />

            <!-- Status -->
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding Status}" HorizontalOptions="Center" TextColor="Gray" FontSize="14" />
            <BoxView HeightRequest="1" Color="LightGray" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                <Label Text="Logs" FontSize="18" FontAttributes="Bold" />
                <Button Grid.Column="1" Text="Request Logs" Command="{Binding RequestLogsCommand}" BackgroundColor="#2196F3" TextColor="White" CornerRadius="8" HeightRequest="40" />
            </Grid>

            <RefreshView Command="{Binding RefreshLogsCommand}" IsRefreshing="{Binding IsRefreshingLogs}">
                <CollectionView ItemsSource="{Binding Logs}" HeightRequest="220"
                                EmptyView="No logs yet. Pull down to refresh.">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="8" Margin="0,4" CornerRadius="6" HasShadow="False">
                                <Label Text="{Binding .}" LineBreakMode="TailTruncation" />
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
